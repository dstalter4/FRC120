{
  "java.configuration.updateBuildConfiguration": "disabled",
  "java.import.gradle.enabled": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "bin/": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true,
    "**/*~": true
  },
  "C_Cpp.default.configurationProvider": "vscode-wpilib",
"wpilib.skipSelectSimulateExtension": true,
"files.associations": {
    "chrono": "cpp",
    "expected": "cpp",
    "optional": "cpp",
    "regex": "cpp",
    "system_error": "cpp"
}
}
